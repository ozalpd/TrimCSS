<Window x:Class="TrimCSS.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrimCSS"
        Width="1280"
        Height="760"
        MinWidth="900"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F0F"
        Foreground="#F0F0F0"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="BgPrimary" Color="#0F0F0F" />
        <SolidColorBrush x:Key="BgSecondary" Color="#1A1A1A" />
        <SolidColorBrush x:Key="BgCard" Color="#1E1E1E" />
        <SolidColorBrush x:Key="BgHover" Color="#262626" />
        <SolidColorBrush x:Key="BorderBrushDark" Color="#2A2A2A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFC" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#6A4DE8" />
        <SolidColorBrush x:Key="RedBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="YellowBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#888888" />

        <!-- Primary Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCard}" />
            <Setter Property="Foreground" Value="#F0F0F0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Pill RadioButton -->
        <Style x:Key="FilterPillStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}" />
                                <Setter Property="Foreground" Value="#F0F0F0" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Dark CheckBox Style -->
        <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box"
                                    Width="16"
                                    Height="16"
                                    Background="{StaticResource BgPrimary}"
                                    BorderBrush="{StaticResource BorderBrushDark}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M 3 8 L 6 11 L 13 4"
                                      Stroke="{StaticResource AccentBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter x:Name="Presenter" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                            <Trigger Property="HasContent" Value="False">
                                <Setter TargetName="Presenter" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Top Action Bar -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📁" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="FolderPathText"
                               Text="No folder selected"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SelectFolderButton"
                            Content="Select Folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="SelectFolderButton_Click" />
                    <Button x:Name="ScanProjectButton"
                            Content="Scan Project"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="ScanProjectButton_Click" />
                    <Button x:Name="ExportReportButton"
                            Content="Export Report"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="False"
                            Click="ExportReportButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Exclusion Rules Bar -->
        <Border Grid.Row="1" Background="#141414" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Exclusions:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBox x:Name="ExclusionFilterBox"
                         Grid.Column="1"
                         Background="{StaticResource BgPrimary}"
                         Foreground="#F0F0F0"
                         CaretBrush="#F0F0F0"
                         BorderBrush="{StaticResource BorderBrushDark}"
                         BorderThickness="1"
                         Padding="8,5"
                         FontSize="12"
                         FontFamily="Consolas"
                         VerticalContentAlignment="Center"
                         ToolTip="Comma-separated folder names or file patterns to exclude during scan (e.g., node_modules, bin, obj, *.min.css, bootstrap*.css)"
                         Text="*.min.css, node_modules, bin, obj, dist, build, .git, .vs" />

                <CheckBox x:Name="ExcludeVendorCssCheckBox"
                          Grid.Column="2"
                          Content="Exclude Vendor CSS (bootstrap*, tailwind*, etc.)"
                          Style="{StaticResource DarkCheckBoxStyle}"
                          VerticalAlignment="Center"
                          Margin="14,0,0,0"
                          ToolTip="Quickly exclude common vendor frameworks (bootstrap*.css, tailwind*.css, font-awesome*.css, vendor*.css)"
                          IsChecked="False" />
            </Grid>
        </Border>

        <!-- Row 2: Metrics Strip -->
        <Border Grid.Row="2" Background="{StaticResource BorderBrushDark}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1">
            <UniformGrid Columns="4">
                <Border Background="{StaticResource BgSecondary}" Padding="16,12" Margin="0,0,1,0">
                    <StackPanel>
                        <TextBlock x:Name="StatTotalText" Text="—" FontFamily="Consolas" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="TOTAL CSS SELECTORS" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource BgSecondary}" Padding="16,12" Margin="0,0,1,0">
                    <StackPanel>
                        <TextBlock x:Name="StatUnusedText" Text="—" FontFamily="Consolas" FontSize="22" FontWeight="Bold" Foreground="{StaticResource RedBrush}" />
                        <TextBlock Text="UNUSED SELECTORS" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource BgSecondary}" Padding="16,12" Margin="0,0,1,0">
                    <StackPanel>
                        <TextBlock x:Name="StatAmbiguousText" Text="—" FontFamily="Consolas" FontSize="22" FontWeight="Bold" Foreground="{StaticResource YellowBrush}" />
                        <TextBlock Text="AMBIGUOUS SELECTORS" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource BgSecondary}" Padding="16,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StatFilesText" Text="—" FontFamily="Consolas" FontSize="22" FontWeight="Bold" />
                            <TextBlock x:Name="StatTimeText" Text="" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="8,0,0,3" />
                        </StackPanel>
                        <TextBlock Text="SCANNED FILES" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Border>

        <!-- Row 3: Filter Controls -->
        <Border Grid.Row="3" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Status Pills -->
                <Border Grid.Column="0" Background="{StaticResource BgPrimary}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="FilterAllRadio" Content="All Flagged" Style="{StaticResource FilterPillStyle}" IsChecked="True" Checked="FilterChanged" />
                        <RadioButton x:Name="FilterUnusedRadio" Content="Unused Only" Style="{StaticResource FilterPillStyle}" Checked="FilterChanged" />
                        <RadioButton x:Name="FilterAmbiguousRadio" Content="Ambiguous Only" Style="{StaticResource FilterPillStyle}" Checked="FilterChanged" />
                    </StackPanel>
                </Border>

                <!-- Search TextBox -->
                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         Background="{StaticResource BgPrimary}"
                         Foreground="#F0F0F0"
                         CaretBrush="#F0F0F0"
                         BorderBrush="{StaticResource BorderBrushDark}"
                         BorderThickness="1"
                         Padding="8,5"
                         FontSize="12.5"
                         Margin="0,0,10,0"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged" />

                <!-- File Filter ComboBox -->
                <ComboBox x:Name="FileFilterCombo"
                          Grid.Column="2"
                          FontFamily="Consolas"
                          FontSize="12"
                          Padding="8,5"
                          VerticalContentAlignment="Center"
                          SelectionChanged="FileFilterCombo_SelectionChanged" />

                <!-- Result Count -->
                <TextBlock x:Name="ResultCountText"
                           Grid.Column="3"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </Grid>
        </Border>

        <!-- Row 4: Results Area (Empty State + Virtualized DataGrid) -->
        <Grid Grid.Row="4">
            <!-- Empty / Status Overlay -->
            <StackPanel x:Name="EmptyStatePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Opacity="0.4" Margin="0,0,0,10" />
                <TextBlock x:Name="EmptyStateMessage"
                           Text="Select a project folder and click Scan Project to detect unused CSS selectors."
                           FontSize="13.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextAlignment="Center" />
            </StackPanel>

            <!-- Virtualized Results DataGrid -->
            <DataGrid x:Name="ResultsGrid"
                      Visibility="Collapsed"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      IsReadOnly="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#222222"
                      Background="{StaticResource BgPrimary}"
                      Foreground="#F0F0F0"
                      RowBackground="#161616"
                      AlternatingRowBackground="#191919"
                      BorderThickness="0"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1A1A1A" />
                        <Setter Property="Foreground" Value="#888888" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="BorderBrush" Value="#2A2A2A" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2A224D" />
                                <Setter Property="Foreground" Value="#F0F0F0" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <!-- Checkbox Column -->
                    <DataGridCheckBoxColumn Width="42" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridCheckBoxColumn.Header>
                            <CheckBox x:Name="SelectAllCheckBox" Style="{StaticResource DarkCheckBoxStyle}" Checked="SelectAllCheckBox_Changed" Unchecked="SelectAllCheckBox_Changed" />
                        </DataGridCheckBoxColumn.Header>
                    </DataGridCheckBoxColumn>

                    <!-- Status Badge Column -->
                    <DataGridTemplateColumn Header="STATUS" Width="110" SortMemberPath="Status" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="7,2" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#2B2111" />
                                            <Setter Property="BorderBrush" Value="#664400" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUnused}" Value="True">
                                                    <Setter Property="Background" Value="#2B1414" />
                                                    <Setter Property="BorderBrush" Value="#662222" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#F59E0B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUnused}" Value="True">
                                                        <Setter Property="Foreground" Value="#EF4444" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Selector Text -->
                    <DataGridTextColumn Header="SELECTOR" Width="2*" Binding="{Binding SelectorText}" FontFamily="Consolas" FontSize="12" IsReadOnly="True" />

                    <!-- Target Classes -->
                    <DataGridTextColumn Header="TARGET CLASSES" Width="1.5*" Binding="{Binding TargetClassesDisplay}" FontFamily="Consolas" FontSize="11.5" Foreground="#A0A0A0" IsReadOnly="True" />

                    <!-- CSS File -->
                    <DataGridTextColumn Header="CSS FILE" Width="1.5*" Binding="{Binding RelativeFilePath}" FontFamily="Consolas" FontSize="11.5" Foreground="#888888" IsReadOnly="True" />

                    <!-- Location -->
                    <DataGridTextColumn Header="LOCATION" Width="90" Binding="{Binding Location}" FontFamily="Consolas" FontSize="11.5" Foreground="#666666" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>