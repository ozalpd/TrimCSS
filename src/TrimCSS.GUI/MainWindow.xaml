<Window x:Class="TrimCSS.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrimCSS"
        Width="1280"
        Height="760"
        MinWidth="900"
        MinHeight="540"
        Icon="Assets/TrimCSS-Icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPrimary}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Primary Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgCard}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Pill RadioButton -->
        <Style x:Key="FilterPillStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Theme-Aware CheckBox Style -->
        <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextCheckBoxBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box"
                                    Width="16"
                                    Height="16"
                                    Background="{DynamicResource BgPrimary}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M 3 8 L 6 11 L 13 4"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter x:Name="Presenter" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                            <Trigger Property="HasContent" Value="False">
                                <Setter TargetName="Presenter" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Top Action Bar -->
        <Border Grid.Row="0" Background="{DynamicResource BgSecondary}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📁" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="FolderPathText"
                               Text="No folder selected"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SelectFolderButton"
                            Content="Select Folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="SelectFolderButton_Click" />
                    <Button x:Name="ScanProjectButton"
                            Content="Scan Project"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="ScanProjectButton_Click" />
                    <Button x:Name="ExportReportButton"
                            Content="Export Report"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="False"
                            Click="ExportReportButton_Click" />
                    <Button x:Name="ThemeToggleButton"
                            Content="☀ Light"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="8,0,0,0"
                            ToolTip="Switch between Dark and Light themes"
                            Click="ThemeToggleButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Exclusion Rules Bar -->
        <Border Grid.Row="1" Background="{DynamicResource BgExclusionsBar}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Exclusions:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBox x:Name="ExclusionFilterBox"
                         Grid.Column="1"
                         Background="{DynamicResource BgPrimary}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderDefaultBrush}"
                         BorderThickness="1"
                         Padding="8,5"
                         FontSize="12"
                         FontFamily="Consolas"
                         VerticalContentAlignment="Center"
                         ToolTip="Comma-separated folder names or file patterns to exclude during scan (e.g., node_modules, bin, obj, *.min.css, bootstrap*.css)"
                         Text="*.min.css, node_modules, bin, obj, dist, build, .git, .vs" />

                <CheckBox x:Name="ExcludeVendorCssCheckBox"
                          Grid.Column="2"
                          Content="Exclude Vendor CSS (bootstrap*, tailwind*, etc.)"
                          Style="{StaticResource DarkCheckBoxStyle}"
                          VerticalAlignment="Center"
                          Margin="14,0,0,0"
                          ToolTip="Quickly exclude common vendor frameworks (bootstrap*.css, tailwind*.css, font-awesome*.css, vendor*.css)"
                          IsChecked="False" />
            </Grid>
        </Border>

        <!-- Row 2: Metrics Strip -->
        <Border Grid.Row="2" Background="{DynamicResource BorderDefaultBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,0,1">
            <UniformGrid Columns="5">
                <Border Background="{DynamicResource BgSecondary}" Padding="16,12" Margin="0,0,1,0">
                    <StackPanel>
                        <TextBlock x:Name="StatTotalText" Text="—" FontFamily="Consolas" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="TOTAL CSS SELECTORS" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource BgSecondary}" Padding="16,12" Margin="0,0,1,0">
                    <StackPanel>
                        <TextBlock x:Name="StatUnusedText" Text="—" FontFamily="Consolas" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource RedBrush}" />
                        <TextBlock Text="UNUSED SELECTORS" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource BgSecondary}" Padding="16,12" Margin="0,0,1,0">
                    <StackPanel>
                        <TextBlock x:Name="StatAmbiguousText" Text="—" FontFamily="Consolas" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource YellowBrush}" />
                        <TextBlock Text="AMBIGUOUS SELECTORS" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource BgSecondary}" Padding="16,12" Margin="0,0,1,0">
                    <StackPanel>
                        <TextBlock x:Name="StatUnusedCssFilesText" Text="—" FontFamily="Consolas" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource RedBrush}" />
                        <TextBlock Text="NOT REFERENCED CSS" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource BgSecondary}" Padding="16,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StatFilesText" Text="—" FontFamily="Consolas" FontSize="22" FontWeight="Bold" />
                            <TextBlock x:Name="StatTimeText" Text="" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="8,0,0,3" />
                        </StackPanel>
                        <TextBlock Text="SCANNED FILES" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Border>

        <!-- Row 3: Filter Controls -->
        <Border Grid.Row="3" Background="{DynamicResource BgSecondary}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- View Mode Switcher -->
                <Border Grid.Column="0" Background="{DynamicResource BgPrimary}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ViewModeSelectorsRadio" GroupName="ViewMode" Content="Selectors" Style="{StaticResource FilterPillStyle}" IsChecked="True" Checked="ViewModeChanged" />
                        <RadioButton x:Name="ViewModeCssFilesRadio" GroupName="ViewMode" Content="CSS Files" Style="{StaticResource FilterPillStyle}" Checked="ViewModeChanged" />
                    </StackPanel>
                </Border>

                <!-- Status Pills -->
                <Border Grid.Column="1" Background="{DynamicResource BgPrimary}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="FilterAllFilesRadio" GroupName="StatusFilter" Content="All Files" Style="{StaticResource FilterPillStyle}" Visibility="Collapsed" Checked="FilterChanged" />
                        <RadioButton x:Name="FilterAllRadio" GroupName="StatusFilter" Content="All Flagged" Style="{StaticResource FilterPillStyle}" IsChecked="True" Checked="FilterChanged" />
                        <RadioButton x:Name="FilterUnusedRadio" GroupName="StatusFilter" Content="Unused Only" Style="{StaticResource FilterPillStyle}" Checked="FilterChanged" />
                        <RadioButton x:Name="FilterAmbiguousRadio" GroupName="StatusFilter" Content="Ambiguous Only" Style="{StaticResource FilterPillStyle}" Checked="FilterChanged" />
                    </StackPanel>
                </Border>

                <!-- Search TextBox -->
                <TextBox x:Name="SearchBox"
                         Grid.Column="2"
                         Background="{DynamicResource BgPrimary}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderDefaultBrush}"
                         BorderThickness="1"
                         Padding="8,5"
                         FontSize="12.5"
                         Margin="0,0,10,0"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged" />

                <!-- File Filter ComboBox -->
                <ComboBox x:Name="FileFilterCombo"
                          Grid.Column="3"
                          Width="240"
                          FontFamily="Consolas"
                          FontSize="12"
                          Padding="8,5"
                          VerticalContentAlignment="Center"
                          SelectionChanged="FileFilterCombo_SelectionChanged" />

                <!-- Result Count -->
                <TextBlock x:Name="ResultCountText"
                           Grid.Column="4"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </Border>

        <!-- Row 4: Results Area (Empty State + Virtualized DataGrid) -->
        <Grid Grid.Row="4">
            <!-- Empty / Status Overlay -->
            <StackPanel x:Name="EmptyStatePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Opacity="0.4" Margin="0,0,0,10" />
                <TextBlock x:Name="EmptyStateMessage"
                           Text="Select a project folder and click Scan Project to detect unused CSS selectors."
                           FontSize="13.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextAlignment="Center" />
            </StackPanel>

            <!-- Virtualized Results DataGrid -->
            <DataGrid x:Name="ResultsGrid"
                      Visibility="Collapsed"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      IsReadOnly="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                      Background="{DynamicResource BgPrimary}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      RowBackground="{DynamicResource GridRowBgBrush}"
                      AlternatingRowBackground="{DynamicResource GridAltRowBgBrush}"
                      BorderThickness="0"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource BgSecondary}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectionBgBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SelectionFgBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <!-- Checkbox Column -->
                    <DataGridCheckBoxColumn Width="42" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridCheckBoxColumn.Header>
                            <CheckBox x:Name="SelectAllCheckBox" Style="{StaticResource DarkCheckBoxStyle}" Checked="SelectAllCheckBox_Changed" Unchecked="SelectAllCheckBox_Changed" />
                        </DataGridCheckBoxColumn.Header>
                    </DataGridCheckBoxColumn>

                    <!-- Status Badge Column -->
                    <DataGridTemplateColumn Header="STATUS" Width="110" SortMemberPath="Status" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="7,2" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AmbiguousBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AmbiguousBorderBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUnused}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource UnusedBgBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource UnusedBorderBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource YellowBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUnused}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource RedBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Selector Text -->
                    <DataGridTextColumn Header="SELECTOR" Width="2*" Binding="{Binding SelectorText}" FontFamily="Consolas" FontSize="12" IsReadOnly="True" />

                    <!-- Target Classes -->
                    <DataGridTextColumn Header="TARGET CLASSES" Width="1.5*" Binding="{Binding TargetClassesDisplay}" FontFamily="Consolas" FontSize="11.5" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- CSS File -->
                    <DataGridTextColumn Header="CSS FILE" Width="1.5*" Binding="{Binding RelativeFilePath}" FontFamily="Consolas" FontSize="11.5" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Location -->
                    <DataGridTextColumn Header="LOCATION" Width="90" Binding="{Binding Location}" FontFamily="Consolas" FontSize="11.5" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Virtualized CSS Files DataGrid -->
            <DataGrid x:Name="CssFilesGrid"
                      Visibility="Collapsed"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      IsReadOnly="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                      Background="{DynamicResource BgPrimary}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      RowBackground="{DynamicResource GridRowBgBrush}"
                      AlternatingRowBackground="{DynamicResource GridAltRowBgBrush}"
                      BorderThickness="0"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource BgSecondary}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                       <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectionBgBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SelectionFgBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <!-- Checkbox Column -->
                    <DataGridCheckBoxColumn Width="42" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridCheckBoxColumn.Header>
                            <CheckBox x:Name="SelectAllCssFilesCheckBox" Style="{StaticResource DarkCheckBoxStyle}" Checked="SelectAllCssFilesCheckBox_Changed" Unchecked="SelectAllCssFilesCheckBox_Changed" />
                        </DataGridCheckBoxColumn.Header>
                    </DataGridCheckBoxColumn>

                    <!-- Status Badge Column -->
                    <DataGridTemplateColumn Header="STATUS" Width="132" SortMemberPath="Status" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="7,2" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AmbiguousBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AmbiguousBorderBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUnused}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource UnusedBgBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource UnusedBorderBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsReferenced}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource YellowBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUnused}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource RedBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsReferenced}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- CSS File -->
                    <DataGridTextColumn Header="CSS FILE" Width="2.2*" Binding="{Binding RelativePath}" FontFamily="Consolas" FontSize="12" IsReadOnly="True" />

                    <!-- Selectors -->
                    <DataGridTextColumn Header="SELECTORS" Width="90" Binding="{Binding SelectorCount}" FontFamily="Consolas" FontSize="11.5" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Usage Rate -->
                    <DataGridTemplateColumn Header="USAGE" Width="75" SortMemberPath="UsagePercentage" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding UsageText}"
                                           Foreground="{Binding UsageColor}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           ToolTip="{Binding UsageTooltip}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Size -->
                    <DataGridTextColumn Header="SIZE" Width="80" Binding="{Binding FormattedSize}" FontFamily="Consolas" FontSize="11.5" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Imported CSS Files -->
                    <DataGridTextColumn Header="IMPORTS" Width="1.8*" Binding="{Binding ImportedFilesDisplay}" SortMemberPath="ImportedCssFilesCount" FontFamily="Consolas" FontSize="11" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding ImportedFilesTooltip}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Details -->
                    <DataGridTextColumn Header="DETAILS" Width="2.2*" Binding="{Binding Details}" FontFamily="Consolas" FontSize="11" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
