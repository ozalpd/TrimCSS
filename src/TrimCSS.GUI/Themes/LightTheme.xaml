<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces & Containers -->
    <SolidColorBrush x:Key="BgPrimary" Color="#F8FAFC" />
    <SolidColorBrush x:Key="BgSecondary" Color="#F1F5F9" />
    <SolidColorBrush x:Key="BgExclusionsBar" Color="#F8FAFC" />
    <SolidColorBrush x:Key="BgCard" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BgHover" Color="#E2E8F0" />
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#CBD5E1" />

    <!-- Typography -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#334155" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#64748B" />
    <SolidColorBrush x:Key="TextCheckBoxBrush" Color="#0F172A" />

    <!-- Primary & Selection -->
    <SolidColorBrush x:Key="AccentBrush" Color="#6A4DE8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5B3FD6" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectionBgBrush" Color="#EDE9FE" />
    <SolidColorBrush x:Key="SelectionFgBrush" Color="#312E81" />

    <!-- Semantic Status -->
    <SolidColorBrush x:Key="RedBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="UnusedBgBrush" Color="#FEF2F2" />
    <SolidColorBrush x:Key="UnusedBorderBrush" Color="#FECACA" />

    <SolidColorBrush x:Key="YellowBrush" Color="#B45309" />
    <SolidColorBrush x:Key="AmbiguousBgBrush" Color="#FFFBEB" />
    <SolidColorBrush x:Key="AmbiguousBorderBrush" Color="#FDE68A" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#047857" />
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#ECFDF5" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#A7F3D0" />

    <!-- DataGrid -->
    <SolidColorBrush x:Key="GridLineBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="GridRowBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GridAltRowBgBrush" Color="#F8FAFC" />

</ResourceDictionary>
